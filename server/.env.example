# ═══════════════════════════════════════════════
# RAILWAY BACKEND ENVIRONMENT VARIABLES
# ═══════════════════════════════════════════════

# Port (Railway assigns this automatically)
PORT=5000

# PostgreSQL Database URL (provided by Railway Postgres service)
DATABASE_URL=postgresql://postgres:password@junction.proxy.rlwy.net:12345/railway

# HiveMQ Public MQTT Broker
HIVEMQ_BROKER_URL=broker.hivemq.com
HIVEMQ_PORT=1883
MQTT_TOPIC=acoustic-leak-detection/sensor-data

# Optional: Disable mock simulator (already off by default)
ENABLE_SIMULATOR=false

# Allowed Frontend URL for CORS
CLIENT_URL=*
